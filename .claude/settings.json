{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'export PATH=\"$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH\"' >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/float/.claude/auto-paste-output.sh"
          }
        ]
      }
    ]
  }
}
